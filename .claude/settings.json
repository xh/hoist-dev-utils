{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "permissions": {
    "allow": [
      "Edit",
      "Glob",
      "Grep",
      "Read",
      "WebFetch",
      "WebSearch",
      "Write",
      "Skill(xh:clear-writing)",
      "Skill(xh:hoist-upgrade)",
      "Skill(xh:onboard-app)",
      "Skill(xh:right-size)",
      "Skill(xh:setup-worktree)",
      "Skill(xh:using-hoist-core-reference)",
      "Skill(xh:using-hoist-react-reference)"
    ]
  },
  "enabledPlugins": {
    "xh@hoist-ai": true
  },
  "extraKnownMarketplaces": {
    "hoist-ai": {
      "source": {
        "source": "github",
        "repo": "xh/hoist-ai"
      },
      "autoUpdate": true
    }
  }
}
